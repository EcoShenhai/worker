# =====================================================================
# Worker :: backend environment (EXAMPLE — no secrets)
# Copy to .env and fill in real values on the server. Never commit .env.
# Variable names follow the cpamind convention used on the droplet.
# =====================================================================

# ---------- PRODUCTION ----------
NODE_ENV=production
APP_NAME=Worker
PORT=4019
APP_DOMAIN=worker.eshcloud.com
APP_BASE_URL=https://worker.eshcloud.com
FRONTEND_URL=https://worker.eshcloud.com

# ---------- AUTH ----------
# Generate: openssl rand -hex 48   (use two different values)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ---------- DATABASE (PostgreSQL) ----------
DB_HOST=
DB_PORT=25060
DB_NAME=worker_db
DB_USER=worker_user
DB_PASSWORD=
DB_SSL=true
DB_SYNC=false

# ---------- SUPER ADMIN (seed only; forced change on first login) ----------
SUPER_ADMIN_EMAIL=pskipchumba@gmail.com
SUPER_ADMIN_NAME=Super Administrator
SUPER_ADMIN_PASSWORD=

# ---------- AI: DeepSeek (text/reasoning only — never speech) ----------
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4000

# ---------- Speech-to-Text (local faster-whisper sidecar) ----------
STT_PROVIDER=faster-whisper
STT_SERVICE_URL=http://127.0.0.1:4020
STT_MODEL=base.en
STT_LANGUAGE=en

# ---------- Storage ----------
STORAGE_DRIVER=local
STORAGE_DIR=uploads
MAX_UPLOAD_MB=200

# ---------- SMTP ----------
SMTP_HOST=
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Office of the President — Worker
SMTP_FROM_EMAIL=

# ---------- PayPal ----------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD

# ---------- M-Pesa Daraja ----------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://worker.eshcloud.com/api/payments/mpesa/callback

# ---------- Security ----------
CORS_ORIGINS=https://worker.eshcloud.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---------- Retention ----------
RETENTION_AUDIO_DAYS=0
